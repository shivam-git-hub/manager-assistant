# Copy to .env and adjust. All values here have hardcoded fallbacks in
# app/config.py, so .env is optional -- only set what you want to override.

# projectkb job cadence (minutes unless noted). For a live demo, uncomment
# the block below to get everything moving on a ~1-minute cadence instead
# of the real-deployment defaults (60m heartbeat / 24h dream / etc) --
# PROJECTKB_POLL_SECONDS is the scheduler's own tick resolution, so it must
# be <= the fastest job interval you set or that job won't actually get
# checked often enough to run every minute.
PROJECTKB_POLL_SECONDS=60
INGESTION_INTERVAL_MINUTES=15
INGESTION_MESSAGE_THRESHOLD=10
HEARTBEAT_INTERVAL_MINUTES=60
DREAM_INTERVAL_MINUTES=1440
LINT_INTERVAL_MINUTES=10080
OUTLOOK_POLL_INTERVAL_MINUTES=5
SLACK_POLL_INTERVAL_MINUTES=5
# --- demo cadence override (uncomment for a live demo) ---
# PROJECTKB_POLL_SECONDS=30
# INGESTION_INTERVAL_MINUTES=1
# HEARTBEAT_INTERVAL_MINUTES=1
# SLACK_POLL_INTERVAL_MINUTES=1

# LLM provider. Default "gemini" talks directly to the Gemini API
# (GEMINI_API_KEY below). Set to "safechain" on the company laptop, where
# direct Gemini access isn't available and every LLM call instead goes
# through the enterprise LangChain gateway (app/agent/safechain_client.py) --
# requires safechain installed in the active conda env (NOT in this repo's
# requirements.txt -- it's a company-internal package) plus CONFIG_PATH/
# DEPLOY_ENV/CIBIS_* below, which safechain's own config loader reads
# directly (not this app).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
SMART_MODEL=
FLASH_MODEL=
# --- safechain-only (LLM_PROVIDER=safechain) ---
# CONFIG_PATH=/path/to/config_e1.yaml
# DEPLOY_ENV=e1
# CIBIS_CONSUMER_INTEGRATION_ID=
# CIBIS_CONSUMER_SECRET=
# SAFECHAIN_MODEL_INDEX=1
# Set to see the exact outgoing LLM payload in the logs (useful for
# diagnosing an AI-firewall/DLP rejection) -- "true" truncates long content,
# "full" doesn't. Leave unset in normal operation (can log message content).
# LLM_LOG_PAYLOAD=true

# Slack -- see app/integrations/SLACK.md. Two independent things:
# (1) reading a manager's own messages: ONE shared "reader" app, user-
# token-only OAuth (GET /auth/slack/install), no bot scope at all.
# (2) agent bots: NOT configured via env at all -- each pool agent's own
# client_id/secret/signing_secret/bot_token live in agents_pool.json
# (gitignored, see agents_pool.json.example), loaded via
# scripts/seed_agents.py. Leave SLACK_READER_* unset to run reading
# unconfigured (install just 500s until set).
SLACK_READER_CLIENT_ID=
SLACK_READER_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3003/auth/slack/callback

# Company-laptop corporate egress proxy -- see app/config.py's
# AEXP_PROXY_URL/SLACK_INSECURE_SSL docstrings. Both no-ops when unset.
# AEXP_PROXY_URL=http://user:pass@proxy.example.com:8080
# SLACK_INSECURE_SSL=true

# Socket Mode ingress (app/integrations/slack_socket.py) -- the
# company-laptop alternative to the Events API webhook, for when no public
# webhook URL is reachable. The correct place for these two credentials is
# per-claimed-Agent (Agent.slack_app_token, set the same manual-DB-insert
# way as bot_token/slack_signing_secret already are) -- these env vars are
# a single-agent demo convenience fallback: SLACK_APP_TOKEN pairs with
# whichever claimed agent's bot_token equals SLACK_BOT_TOKEN. Requires
# slack_bolt + slack_sdk installed (see requirements.txt) and Socket Mode
# enabled on the Slack app's settings page.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_SIGNING_SECRET=

# Outlook connector -- see app/integrations/OUTLOOK.md. OUTLOOK_AUTH_MODE
# is "app" (client-credentials, needs tenant admin) or "delegated"
# ("Sign in with Microsoft" redirect flow via GET /auth/outlook/login).
# Both modes are confidential-client and need MS_GRAPH_CLIENT_SECRET.
OUTLOOK_AUTH_MODE=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_REDIRECT_URI=http://localhost:3003/auth/outlook/callback
OUTLOOK_MAILBOX=

# Dev-only bootstrap login (POST /api/auth/dev-login) -- set to false to
# disable once real login (Outlook redirect, above) is wired up in the UI.
DEV_AUTH_ENABLED=true

# The Pulse.ai React frontend (frontend/, Vite dev server on 5173) -- where
# post-OAuth redirects (Outlook login, Slack install) send the browser.
# Change to the built frontend's real origin in production.
FRONTEND_URL=http://localhost:5173
