# Copy to .env and adjust. All values here have hardcoded fallbacks in
# app/config.py, so .env is optional -- only set what you want to override.

# projectkb job cadence (minutes unless noted)
PROJECTKB_POLL_SECONDS=60
INGESTION_INTERVAL_MINUTES=15
INGESTION_MESSAGE_THRESHOLD=10
HEARTBEAT_INTERVAL_MINUTES=60
DREAM_INTERVAL_MINUTES=1440
LINT_INTERVAL_MINUTES=10080
OUTLOOK_POLL_INTERVAL_MINUTES=5

# Slack -- see app/integrations/SLACK.md. Two independent things:
# (1) reading a manager's own messages: ONE shared "reader" app, user-
# token-only OAuth (GET /auth/slack/install), no bot scope at all.
# (2) agent bots: NOT configured via env at all -- each pool agent's own
# client_id/secret/signing_secret/bot_token live in agents_pool.json
# (gitignored, see agents_pool.json.example), loaded via
# scripts/seed_agents.py. Leave SLACK_READER_* unset to run reading
# unconfigured (install just 500s until set).
SLACK_READER_CLIENT_ID=
SLACK_READER_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3003/auth/slack/callback

# Outlook connector -- see app/integrations/OUTLOOK.md. OUTLOOK_AUTH_MODE
# is "app" (client-credentials, needs tenant admin) or "delegated"
# ("Sign in with Microsoft" redirect flow via GET /auth/outlook/login).
# Both modes are confidential-client and need MS_GRAPH_CLIENT_SECRET.
OUTLOOK_AUTH_MODE=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_REDIRECT_URI=http://localhost:3003/auth/outlook/callback
OUTLOOK_MAILBOX=

# Dev-only bootstrap login (POST /api/auth/dev-login) -- set to false to
# disable once real login (Outlook redirect, above) is wired up in the UI.
DEV_AUTH_ENABLED=true

# The Pulse.ai React frontend (frontend/, Vite dev server on 5173) -- where
# post-OAuth redirects (Outlook login, Slack install) send the browser.
# Change to the built frontend's real origin in production.
FRONTEND_URL=http://localhost:5173
